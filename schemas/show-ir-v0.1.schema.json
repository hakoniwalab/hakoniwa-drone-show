{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hakoniwalab.github.io/hakoniwa-drone-show/schemas/show-ir-v0.1.schema.json",
  "title": "Hakoniwa Show IR v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "show_id",
    "time_unit",
    "coordinate_system",
    "interpolation",
    "drone_ids",
    "timeline"
  ],
  "properties": {
    "schema_version": { "const": "0.1" },
    "show_id": { "$ref": "#/$defs/identifier" },
    "title": { "type": "string", "minLength": 1, "maxLength": 128 },
    "time_unit": { "const": "second" },
    "coordinate_system": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frame", "position_unit"],
      "properties": {
        "frame": { "const": "ENU" },
        "position_unit": { "const": "meter" }
      }
    },
    "placement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "latitude_deg",
        "longitude_deg",
        "altitude_offset_m",
        "heading_deg"
      ],
      "properties": {
        "latitude_deg": { "type": "number", "minimum": -90, "maximum": 90 },
        "longitude_deg": { "type": "number", "minimum": -180, "maximum": 180 },
        "altitude_offset_m": { "type": "number" },
        "heading_deg": { "type": "number", "minimum": 0, "exclusiveMaximum": 360 }
      }
    },
    "interpolation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["position", "led"],
      "properties": {
        "position": { "const": "linear" },
        "led": { "const": "hold" }
      }
    },
    "drone_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/identifier" }
    },
    "timeline": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/frame" }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "position": {
      "type": "array",
      "prefixItems": [
        { "type": "number" },
        { "type": "number" },
        { "type": "number" }
      ],
      "minItems": 3,
      "maxItems": 3
    },
    "led": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rgb", "brightness"],
      "properties": {
        "rgb": {
          "type": "array",
          "prefixItems": [
            { "type": "integer", "minimum": 0, "maximum": 255 },
            { "type": "integer", "minimum": 0, "maximum": 255 },
            { "type": "integer", "minimum": 0, "maximum": 255 }
          ],
          "minItems": 3,
          "maxItems": 3
        },
        "brightness": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "drone_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["drone_id", "position_m", "led"],
      "properties": {
        "drone_id": { "$ref": "#/$defs/identifier" },
        "position_m": { "$ref": "#/$defs/position" },
        "led": { "$ref": "#/$defs/led" }
      }
    },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["time_sec", "states"],
      "properties": {
        "time_sec": { "type": "number", "minimum": 0 },
        "states": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/drone_state" }
        }
      }
    }
  }
}
