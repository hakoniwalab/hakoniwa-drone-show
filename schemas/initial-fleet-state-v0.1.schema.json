{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hakoniwalab.github.io/hakoniwa-drone-show/schemas/initial-fleet-state-v0.1.schema.json",
  "title": "Hakoniwa Initial Fleet State v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "coordinate_system", "states"],
  "properties": {
    "schema_version": { "const": "0.1" },
    "coordinate_system": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frame", "position_unit"],
      "properties": {
        "frame": { "const": "ENU" },
        "position_unit": { "const": "meter" }
      }
    },
    "states": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/state" }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "position": {
      "type": "array",
      "prefixItems": [
        { "type": "number" },
        { "type": "number" },
        { "type": "number" }
      ],
      "minItems": 3,
      "maxItems": 3
    },
    "led": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rgb", "brightness"],
      "properties": {
        "rgb": {
          "type": "array",
          "prefixItems": [
            { "type": "integer", "minimum": 0, "maximum": 255 },
            { "type": "integer", "minimum": 0, "maximum": 255 },
            { "type": "integer", "minimum": 0, "maximum": 255 }
          ],
          "minItems": 3,
          "maxItems": 3
        },
        "brightness": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["drone_id", "position_m", "led"],
      "properties": {
        "drone_id": { "$ref": "#/$defs/identifier" },
        "position_m": { "$ref": "#/$defs/position" },
        "led": { "$ref": "#/$defs/led" }
      }
    }
  }
}
