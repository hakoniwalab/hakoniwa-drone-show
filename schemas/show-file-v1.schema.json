{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hakoniwalab.github.io/hakoniwa-drone-show/schemas/show-file-v1.schema.json",
  "title": "Hakoniwa Show File v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "show_id", "formations", "timeline"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "show_id": { "$ref": "#/$defs/identifier" },
    "title": { "type": "string", "minLength": 1, "maxLength": 128 },
    "assignment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy"],
      "properties": { "strategy": { "enum": ["index", "nearest-greedy"] } }
    },
    "formations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["formation_id", "svg"],
        "properties": {
          "formation_id": { "$ref": "#/$defs/identifier" },
          "title": { "type": "string", "minLength": 1, "maxLength": 128 },
          "svg": { "type": "string", "minLength": 1, "maxLength": 512 }
        }
      }
    },
    "timeline": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step_id", "formation_id", "transition_sec", "hold_sec", "led"],
        "properties": {
          "step_id": { "$ref": "#/$defs/identifier" },
          "formation_id": { "$ref": "#/$defs/identifier" },
          "transition_sec": { "type": "number", "exclusiveMinimum": 0 },
          "hold_sec": { "type": "number", "minimum": 0 },
          "led": {
            "oneOf": [
              { "$ref": "#/$defs/ledState" },
              { "$ref": "#/$defs/ledPlan" }
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "ledState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rgb", "brightness"],
      "properties": {
        "effect": { "const": "steady" },
        "rgb": {
          "type": "array",
          "prefixItems": [
            { "type": "integer", "minimum": 0, "maximum": 255 },
            { "type": "integer", "minimum": 0, "maximum": 255 },
            { "type": "integer", "minimum": 0, "maximum": 255 }
          ],
          "minItems": 3,
          "maxItems": 3
        },
        "brightness": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "ledPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default"],
      "properties": {
        "default": { "$ref": "#/$defs/ledState" },
        "roles": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/identifier" },
          "additionalProperties": { "$ref": "#/$defs/ledState" }
        }
      }
    }
  }
}
